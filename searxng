#!/usr/bin/env bash

set -e

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
COMPOSE_FILE="${SCRIPT_DIR}/compose.yml"
COMPOSE_CLOUDFLARE_FILE="${SCRIPT_DIR}/compose.cloudflare.yml"
CONTAINER_NAME="searxng"
IMAGE="docker.io/searxng/searxng:latest"
CONFIG_DIR="${SCRIPT_DIR}/config"
HOST_PORT=9009
CONTAINER_PORT=8080

load_dotenv() {
  local env_file="${SCRIPT_DIR}/.env"
  local line key val

  [ -f "${env_file}" ] || return 0

  while IFS= read -r line || [ -n "${line}" ]; do
    line="${line#"${line%%[![:space:]]*}"}"
    line="${line%"${line##*[![:space:]]}"}"
    [ -z "${line}" ] && continue
    case "${line}" in
      \#*) continue ;;
    esac
    case "${line}" in
      *=*) ;;
      *) continue ;;
    esac
    key="${line%%=*}"
    val="${line#*=}"
    key="${key%"${key##*[![:space:]]}"}"
    if [ -z "${!key+x}" ]; then
      export "${key}=${val}"
    fi
  done < "${env_file}"
}

load_dotenv

compose_args() {
  local args=(-f "${COMPOSE_FILE}")

  if [ -n "${CLOUDFLARE_TUNNEL_TOKEN:-}" ]; then
    args+=(-f "${COMPOSE_CLOUDFLARE_FILE}")
  fi

  printf '%s\n' "${args[@]}"
}

require_secret() {
  if [ -z "${SEARXNG_SECRET:-}" ]; then
    cat >&2 <<'EOF'
Error: SEARXNG_SECRET is not set
  cp .env.example .env
  # then set SEARXNG_SECRET in .env, or:
  export SEARXNG_SECRET="$(openssl rand -hex 32)"
EOF
    exit 1
  fi
}

print_endpoints() {
  local status="$1"

  cat <<EOF

SearXNG is ${status}
  Web UI        http://localhost:${HOST_PORT}
  Suggestions   http://localhost:${HOST_PORT}/autocompleter?q=<string>
  JSON API      http://localhost:${HOST_PORT}/search?q=test&format=json
EOF
}

check_docker() {
  if ! command -v docker >/dev/null 2>&1 || ! docker compose version >/dev/null 2>&1; then
    cat >&2 <<'EOF'
Error: Docker Compose not found
  Install Docker Desktop or Docker Engine with Compose
EOF
    exit 1
  fi
}

docker_start() {
  local clean="${1:-false}"

  check_docker
  require_secret

  if [ "${clean}" = true ]; then
    docker_clean
    docker compose $(compose_args) pull
  fi

  docker compose $(compose_args) up -d
  print_endpoints "starting"
}

docker_clean() {
  check_docker
  docker compose $(compose_args) down --remove-orphans -v --rmi all || true
  clean_config_data
}

docker_stop() {
  check_docker
  docker compose $(compose_args) down
  echo ""
  echo "SearXNG stopped"
}

docker_restart() {
  docker_stop
  docker_start
}

check_ac() {
  if ! command -v container >/dev/null 2>&1; then
    cat >&2 <<'EOF'
Error: Apple Container CLI not found
  Install from https://github.com/apple/container/releases
EOF
    exit 1
  fi
}

ensure_ac_system() {
  local status

  if ! status="$(container system status 2>/dev/null | awk '/^status/ {print $2}')"; then
    container system start
    return
  fi

  if [ "${status}" != "running" ]; then
    container system start
  fi
}

ac_exists() {
  container list -a -q 2>/dev/null | grep -qx "${CONTAINER_NAME}"
}

ac_running() {
  container list -q 2>/dev/null | grep -qx "${CONTAINER_NAME}"
}

ac_image_exists() {
  container image inspect "${IMAGE}" >/dev/null 2>&1
}

ac_dns_args() {
  local dns

  # Apple Container defaults to 192.168.64.1, which often does not resolve names.
  dns="$(scutil --dns 2>/dev/null | awk '/^  nameserver\[0\] :/ {print $3; exit}')"
  if [ -n "${dns}" ]; then
    printf '%s\n' --dns "${dns}"
  fi
  printf '%s\n' --dns 1.1.1.1 --dns 8.8.8.8
}

clean_config_data() {
  local item

  for item in "${CONFIG_DIR}"/*; do
    [ -e "${item}" ] || continue
    [ "$(basename "${item}")" = "settings.yml" ] && continue
    rm -rf "${item}"
  done
}

ac_clean() {
  check_ac
  ensure_ac_system

  if ac_exists; then
    if ac_running; then
      container stop "${CONTAINER_NAME}"
    fi
    container delete -f "${CONTAINER_NAME}"
  fi

  if ac_image_exists; then
    container image delete -f "${IMAGE}"
  fi

  clean_config_data
}

ac_start() {
  local clean="${1:-false}"

  check_ac
  ensure_ac_system
  require_secret

  if [ "${clean}" = true ]; then
    ac_clean
    container image pull "${IMAGE}"
  else
    if ac_running; then
      print_endpoints "already running"
      return 0
    fi

    if ! ac_image_exists; then
      container image pull "${IMAGE}"
    fi

    if ac_exists; then
      container delete -f "${CONTAINER_NAME}"
    fi
  fi

  container run -d \
    --name "${CONTAINER_NAME}" \
    -p "${HOST_PORT}:${CONTAINER_PORT}" \
    $(ac_dns_args) \
    -e "SEARXNG_BASE_URL=${SEARXNG_BASE_URL:-http://localhost:${HOST_PORT}/}" \
    -e "SEARXNG_SECRET=${SEARXNG_SECRET}" \
    -e "UWSGI_WORKERS=${UWSGI_WORKERS:-4}" \
    -e "UWSGI_THREADS=${UWSGI_THREADS:-4}" \
    -v "${CONFIG_DIR}:/etc/searxng" \
    "${IMAGE}"

  print_endpoints "starting"
}

ac_stop() {
  check_ac
  ensure_ac_system

  if ! ac_exists; then
    echo ""
    echo "SearXNG is not running"
    return 0
  fi

  if ac_running; then
    container stop "${CONTAINER_NAME}"
  fi

  container delete "${CONTAINER_NAME}"
  echo ""
  echo "SearXNG stopped"
}

ac_restart() {
  ac_stop
  ac_start
}

usage() {
  cat >&2 <<'EOF'
Usage: ./searxng <docker|ac> <command> [options]

Runtimes:
  docker     Docker Compose
  ac         Apple Container

Commands:
  start [--clean]   Start SearXNG (requires SEARXNG_SECRET)
  stop              Stop SearXNG
  restart           Stop and recreate SearXNG (requires SEARXNG_SECRET)

Options:
  --clean           Remove existing containers, images, and runtime data,
                    pull a fresh image, then start
EOF
  exit 1
}

runtime="${1:-}"
command="${2:-}"
clean=false

if [ "${3:-}" = "--clean" ]; then
  clean=true
elif [ -n "${3:-}" ]; then
  usage
fi

case "${runtime}:${command}" in
  docker:start) docker_start "${clean}" ;;
  docker:stop) docker_stop ;;
  docker:restart) docker_restart ;;
  ac:start) ac_start "${clean}" ;;
  ac:stop) ac_stop ;;
  ac:restart) ac_restart ;;
  *) usage ;;
esac
