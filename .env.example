# Required - generate with: openssl rand -hex 32
SEARXNG_SECRET=

# Public base URL for this instance
SEARXNG_BASE_URL=http://localhost:9009/

# uWSGI (defaults shown)
UWSGI_WORKERS=4
UWSGI_THREADS=4

# Uncomment to start cloudflared via compose.cloudflare.yml (Docker only)
# CLOUDFLARE_TUNNEL_TOKEN=
# SEARXNG_BASE_URL=https://search.example.com/
